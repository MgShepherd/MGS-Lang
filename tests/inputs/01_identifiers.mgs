-- TEST constant definition
-- EXPECTED_STATUS_CODE 10
func main() -> i32 {
	x: i32 = 10;
	return x;
}

-- TEST variable definition and assignment
-- EXPECTED_STATUS_CODE 23
func main() -> i32 {
	x: var i32 = 10 + 12;
	x = x + 1;
	return x;
}

-- TEST identifiers defined with other identifiers
-- EXPECTED_STATUS_CODE 20
func main() -> i32 {
	x: var i32 = 10 + 12;
	y: i32 = x - 2;
	x = x + 1;
	return y;
}

-- TEST boolean Identifiers
-- EXPECTED_STATUS_CODE 20
func main() -> i32 {
	my_bool: bool = true;
	my_num: i32 = 20;
	return my_num;
}

-- TEST undefined variable in return
-- EXPECTED_COMPILATION_ERROR Undefined variable: x
func main() -> i32 {
	return x;
}

-- TEST undefined variable in assigment expression
-- EXPECTED_COMPILATION_ERROR Undefined variable: y
func main() -> i32 {
	x: i32 = y + 10;
	return x;
}

-- TEST variable defined in terms of itself
-- EXPECTED_COMPILATION_ERROR Undefined variable: x
func main() -> i32 {
	x: i32 = x + 10;
	return x;
}

-- TEST assignment to undefined variable
-- EXPECTED_COMPILATION_ERROR Undefined variable: x
func main() -> i32 {
	x = 10;
	return x;
}

-- TEST expression type does not match identifier type
-- EXPECTED_COMPILATION_ERROR Boolean literal true used in non-boolean expression type: D_I32
func main() -> i32 {
	x: i32 = true;
	return x;
}

-- TEST expression with variable of incorrect type
-- EXPECTED_COMPILATION_ERROR Variable y does not have expected type D_I32
func main() -> i32 {
	y: bool = true;
	x: i32 = 10 + y;
	return x;
}

-- TEST single expression statement with none-void type
-- EXPECTED_COMPILATION_ERROR Numeric literal 10 used in non-numerical expression type: D_VOID
func main() -> i32 {
	10 + 12;
	return x;
}
