-- TEST single if Branch
-- EXPECTED_STATUS_CODE 100
func main() -> i32 {
	x: i32 = 10;
	y: var i32 = 5;

	if x < 12 {
		y = 100;
	}

	return y;
}

-- TEST if with else
-- EXPECTED_STATUS_CODE 1
func main() -> i32 {
	x: i32 = 10;
	y: var i32 = 5;

	if x < 8 {
		y = 100;
	} else {
		y = 1;
	}

	return y;
}

-- TEST if with else if
-- EXPECTED_STATUS_CODE 12
func main() -> i32 {
	x: i32 = 10;
	y: var i32 = 5;

	if x < 9 {
		y = 10;
	} else if x < 10 {
		y = 11;
	}
	else if x < 11 {
		y = 12;
	} else {
		y = 1;
	}

	return y;
}

-- TEST if with no condition
-- EXPECTED_COMPILATION_ERROR Invalid token type for expression: T_LEFT_CURLY
func main() -> i32 {
	x: var i32 = 10;

	if {
		x = 100;
	}

	return x;
}

-- TEST else if with no condition
-- EXPECTED_COMPILATION_ERROR Invalid token type for expression: T_LEFT_CURLY
func main() -> i32 {
	x: var i32 = 10;

	if x < 10 {
		x = 100;
	} else if {
		x = 20;
	}

	return x;
}

-- TEST else if without leading if
-- EXPECTED_COMPILATION_ERROR Invalid token type for expression: T_ELSE
func main() -> i32 {
	x: var i32 = 10;

	else if x < 10 {
		x = 100;
	}

	return x;
}

-- TEST else without leading if
-- EXPECTED_COMPILATION_ERROR Invalid token type for expression: T_ELSE
func main() -> i32 {
	x: var i32 = 10;

	else {
		x = 100;
	}

	return x;
}

-- TEST if with non-boolean terminal expression
-- EXPECTED_COMPILATION_ERROR Numeric literal 10 used in non-numerical expression type: D_BOOL
func main() -> i32 {
	x: var i32 = 10;

	if 10 {
		x = 100;
	}

	return x;
}

-- TEST if with non-boolean compound expression
-- EXPECTED_COMPILATION_ERROR Invalid operator type O_PLUS for expression type D_BOOL
func main() -> i32 {
	x: var i32 = 10;

	if x + 10 {
		x = 100;
	}

	return x;
}

-- TEST Variable defined in if statement only has scope in that if statement
-- EXPECTED_COMPILATION_ERROR Undefined variable: y
func main() -> i32 {
	x: var i32 = 10;

	if x + 10 {
		y: i32 = 10;
		x = 100 + y;
	}
	x = x - y;

	return x;
}
