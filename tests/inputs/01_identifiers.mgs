-- TEST constant definition
-- EXPECTED_STATUS_CODE 10
main: func() -> i32 {
	x: i32 = 10;
	return x;
}

-- TEST variable definition and assignment
-- EXPECTED_STATUS_CODE 23
main: func() -> i32 {
	x: var i32 = 10 + 12;
	x = x + 1;
	return x;
}

-- TEST identifiers defined with other identifiers
-- EXPECTED_STATUS_CODE 20
main: func() -> i32 {
	x: var i32 = 10 + 12;
	y: i32 = x - 2;
	x = x + 1;
	return y;
}

-- TEST boolean Identifiers
-- EXPECTED_STATUS_CODE 20
main: func() -> i32 {
	my_bool: bool = true;
	my_num: i32 = 20;
	return my_num;
}

-- TEST variable redefined in multiple functions
-- EXPECTED_STATUS_CODE 31
example: func() -> void {
	x: i32 = 10;
}

main: func() -> i32 {
	x: i32 = 31;
	return x;
}


-- TEST undefined variable in return
-- EXPECTED_COMPILATION_ERROR Undefined variable: x
main: func() -> i32 {
	return x;
}

-- TEST undefined variable in assigment expression
-- EXPECTED_COMPILATION_ERROR Undefined variable: y 
main: func() -> i32 {
	x: i32 = y + 10;
	return x;
}

-- TEST variable defined in terms of itself
-- EXPECTED_COMPILATION_ERROR Undefined variable: x
main: func() -> i32 {
	x: i32 = x + 10;
	return x;
}

-- TEST assignment to undefined variable
-- EXPECTED_COMPILATION_ERROR Undefined variable: x
main: func() -> i32 {
	x = 10;
	return x;
}

-- TEST expression type does not match identifier type
-- EXPECTED_COMPILATION_ERROR Boolean literal true used in non-boolean expression type: P_I32
main: func() -> i32 {
	x: i32 = true;
	return x;
}

-- TEST expression with variable of incorrect type
-- EXPECTED_COMPILATION_ERROR Variable y does not have expected type P_I32
main: func() -> i32 {
	y: bool = true;
	x: i32 = 10 + y;
	return x;
}

-- TEST single expression statement with none-void type
-- EXPECTED_COMPILATION_ERROR Numeric literal 10 used in non-numerical expression type: P_VOID
main: func() -> i32 {
	10 + 12;
	return x;
}

-- TEST variable definition with void datatype
-- EXPECTED_COMPILATION_ERROR Cannot use void as datatype for variable
test1: func() -> void {
	y: i32 = 10;
}

main: func() -> i32 {
	x: void = test1();
	return 10;
}

-- TEST out of scope variable is undefined
-- EXPECTED_COMPILATION_ERROR Undefined variable: y
test1: func() -> i32 {
	y: i32 = 10;
	return y;
}

main: func() -> i32 {
	x: i32 = test1() + y;
	return 10;
}

-- TEST variable shadowing is not allowed
-- EXPECTED_COMPILATION_ERROR Variable x shadows existing variable in scope
main: func() -> i32 {
	x: i32 = 10;
	if 5 < 10 {
		x: i32 = 12;
	}
	return x;
}
