-- TEST Single if Branch
-- EXPECTED_STATUS_CODE 100
func main() -> i32 {
	x: i32 = 10;
	y: var i32 = 5;

	if x < 12 {
		y = 100;
	}

	return y;
}

-- TEST If with else
-- EXPECTED_STATUS_CODE 1
func main() -> i32 {
	x: i32 = 10;
	y: var i32 = 5;

	if x < 8 {
		y = 100;
	} else {
		y = 1;
	}

	return y;
}

-- TEST If with else if
-- EXPECTED_STATUS_CODE 12
func main() -> i32 {
	x: i32 = 10;
	y: var i32 = 5;

	if x < 9 {
		y = 10;
	} else if x < 10 {
		y = 11;
	}
	else if x < 11 {
		y = 12;
	} else {
		y = 1;
	}

	return y;
}
