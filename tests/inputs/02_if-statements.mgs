-- TEST single if Branch
-- EXPECTED_STATUS_CODE 100
main: func() -> i32 {
	x: i32 = 10;
	y: var i32 = 5;

	if x < 12 {
		y = 100;
	}

	return y;
}

-- TEST if with else
-- EXPECTED_STATUS_CODE 1
main: func() -> i32 {
	x: i32 = 10;
	y: var i32 = 5;

	if x < 8 {
		y = 100;
	} else {
		y = 1;
	}

	return y;
}

-- TEST if with else if
-- EXPECTED_STATUS_CODE 12
main: func() -> i32 {
	x: i32 = 10;
	y: var i32 = 5;

	if x < 9 {
		y = 10;
	} else if x < 10 {
		y = 11;
	}
	else if x < 11 {
		y = 12;
	} else {
		y = 1;
	}

	return y;
}

-- TEST Early return from if statements
-- EXPECTED_STATUS_CODE 100
main: func() -> i32 {
	x: var i32 = 9;

	if x < 10 {
		return 100;
	} else if x < 20 {
		return 200;
	} else {
		return 10;
	}

	return 20;
}

-- TEST if with no condition
-- EXPECTED_COMPILATION_ERROR Token type T_LEFT_CURLY is not a valid terminal literal
main: func() -> i32 {
	x: var i32 = 10;

	if {
		x = 100;
	}

	return x;
}

-- TEST if with code after return statement
-- EXPECTED_COMPILATION_ERROR Dead code after return statement
main: func() -> i32 {
	x: var i32 = 10;

	if x < 12 {
		return 100;
		x = 10;
	}

	return x;
}

-- TEST else if with no condition
-- EXPECTED_COMPILATION_ERROR Token type T_LEFT_CURLY is not a valid terminal literal
main: func() -> i32 {
	x: var i32 = 10;

	if x < 10 {
		x = 100;
	} else if {
		x = 20;
	}

	return x;
}

-- TEST else if without leading if
-- EXPECTED_COMPILATION_ERROR Token type T_ELSE is not a valid terminal literal
main: func() -> i32 {
	x: var i32 = 10;

	else if x < 10 {
		x = 100;
	}

	return x;
}

-- TEST else without leading if
-- EXPECTED_COMPILATION_ERROR Token type T_ELSE is not a valid terminal literal
main: func() -> i32 {
	x: var i32 = 10;

	else {
		x = 100;
	}

	return x;
}

-- TEST if with non-boolean terminal expression
-- EXPECTED_COMPILATION_ERROR Numeric literal 10 used in non-numerical expression type: P_BOOL
main: func() -> i32 {
	x: var i32 = 10;

	if 10 {
		x = 100;
	}

	return x;
}

-- TEST if with non-boolean compound expression
-- EXPECTED_COMPILATION_ERROR Invalid operator type O_PLUS for expression type P_BOOL
main: func() -> i32 {
	x: var i32 = 10;

	if x + 10 {
		x = 100;
	}

	return x;
}

-- TEST Variable defined in if statement only has scope in that if statement
-- EXPECTED_COMPILATION_ERROR Undefined variable: y
main: func() -> i32 {
	x: var i32 = 10;

	if x < 10 {
		y: i32 = 10;
		x = 100 + y;
	}
	x = x - y;

	return x;
}
