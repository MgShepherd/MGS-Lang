-- TEST function call from main
-- EXPECTED_STATUS_CODE 12
func test1() -> i32 {
	return 12;
}

func main() -> i32 {
	result: i32 = test1();
	return result;
}

-- TEST function call within compound expression
-- EXPECTED_STATUS_CODE 42
func test1() -> i32 {
	return 22;
}

func main() -> i32 {
	result: i32 = 20 + test1();
	return result;
}

-- TEST void function
-- EXPECTED_STATUS_CODE 12
func test1() -> void {
	x: i32 = 10;
}

func main() -> i32 {
	test1();
	return 12;
}

-- TEST function with parameters
-- EXPECTED_STATUS_CODE 27
func add10(x: i32) -> i32 {
	return x + 10;
}

func main() -> i32 {
	y: i32 = add10(12) + 5;
	return y;
}

-- TEST function with multiple parameters of different types
-- EXPECTED_STATUS_CODE 17
func my_func(x: i32, my_bool: bool) -> i32 {
	y: var i32 = x;
	if my_bool {
		y = y + 5;
	} else {
		y = y - 5;
	}
	return y;
}

func main() -> i32 {
	z: i32 = my_func(12, true);
	return z;
}

-- TEST function call without parentheseses
-- EXPECTED_COMPILATION_ERROR Undefined variable: test1
func test1() -> void {
	x: i32 = 10;
}

func main() -> i32 {
	test1;
	return 12;
}

-- TEST void function used within typed expression
-- EXPECTED_COMPILATION_ERROR Function test1 does not return expected type D_I32
func test1() -> void {
	x: i32 = 10;
}

func main() -> i32 {
	x: i32 = test1();
	return 12;
}

-- TEST function call with incorrect number of parameters
-- EXPECTED_COMPILATION_ERROR Mismatched number of parameters in function call, expected 2, got 1
func my_func(x: i32, my_bool: bool) -> i32 {
	y: var i32 = x;
	if my_bool {
		y = y + 5;
	} else {
		y = y - 5;
	}
	return y;
}

func main() -> i32 {
	z: i32 = my_func(12);
	return z;
}
