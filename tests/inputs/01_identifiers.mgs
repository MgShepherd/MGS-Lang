-- TEST Constant definition
-- EXPECTED_STATUS_CODE 10
func main() -> i32 {
	x: i32 = 10;
	return x;
}

-- TEST Variable definition and assignment
-- EXPECTED_STATUS_CODE 23
func main() -> i32 {
	x: var i32 = 10 + 12;
	x = x + 1;
	return x;
}

-- TEST Identifiers defined with other identifiers
-- EXPECTED_STATUS_CODE 20
func main() -> i32 {
	x: var i32 = 10 + 12;
	y: i32 = x - 2;
	x = x + 1;
	return y;
}

-- TEST Boolean Identifiers
-- EXPECTED_STATUS_CODE 20
func main() -> i32 {
	my_bool: bool = true;
	my_num: i32 = 20;
	return my_num;
}
